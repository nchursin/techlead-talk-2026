#slide(
  [Цифры из реальных кейсов],
  [
    #card([
      #text(size: 20pt)[
        - *Microsoft и IBM, 2003–2008*
        - Время разработки: +15–35% на старте
        - Плотность дефектов в production: −40–90%
        - IBM строгий TDD: −50% дефектов
      ]
    ])
    #v(0.14in)
    #card(
      [
        #text(size: 18pt)[Overhead на старте окупается сокращением bug-fixing и поддержки]
