#import "../../theme.typ": *

#objection(
  [С TDD тесты хрупкие — разваливаются при каждом рефакторинге],
  [],
)

#slide(
  [Хрупкие тесты],
  [
    #card([
      #text(size: 20pt)[
        - Хрупкость = тест знает про реализацию, не про поведение
        - TDD по природе толкает тестировать поведение — реализации ещё нет
        - Хрупкий тест - диагностический сигнал: смотри, где тест знает детали имплементации
      ]
    ])
    Хрупкость тестов — проблема системы.
  ],
  kicker: [Миф: TDD = хрупкие тесты],
)

#thesis(
  [Откуда чаще всего тесты знают про реализацию?],
  [],
)

#objection(
  [Моки!],
  [],
)

#slide(
  [London vs Chicago],
  [
    #two-cols(
      [#card([
        #text(size: 20pt, weight: "bold")[Классика (Chicago)]

        #text(size: 20pt)[
          - От простейшего теста к более сложным
          - От деталей к верхнеуровневому поведению
          - Тестируем на реальных системах по максимуму
        ]
      ])],
      [#card([
        #text(size: 20pt, weight: "bold")[Mockist (London)]

        #text(size: 20pt)[
          - От API к нижним уровням системы
          - Определяем границы модуля
          - Мокируем зависимости
        ]
        #text(size: 20pt)[Тесты знают топологию системы.]
        #text(size: 20pt)[Но внутри уровня свобода остаётся.]
      ])],
    )
  ],
  kicker: [Миф: TDD = хрупкие тесты],
)

#thesis(
  [TDD требует дисциплины!],
  [],
)

#cheatsheet(
  [Как делать TDD],
  [
    #card([
      #text(size: 20pt)[
        1. Составь список примеров, с которых планируешь начать.
        2. Начинаем идти по списку тестов циклом TDD: #text(fill: red)[RED]-#text(fill: green)[GREEN]-#text(fill: yellow)[REFACTOR].
        3. Минимальные изменения
        4. Нельзя пропускать рефакторинг!
        5. Постоянно обновляем список тестов.
        6. Два подхода
          - Двигаемся от простого к сложному (Chicago)
          - Дивгаемся от приёмочного поведения к деталям через моки (London)
      ]
    ])
  ],
)

#objection(
  [Ну допустим, но все вокруг продолжают писать как обычно...],
  [],
)

#slide(
  [TDD и команда],
  [
    #card([
      #text(size: 20pt)[
        - Это классно, когда вся команда в едином порыве...
        - Но это необязательно
        - И вам придётся следить за тестами на ревью внимательнее
      ]
    ])
  ],
)

#thesis(
  [Чистый код важен.],
  [Код пишется не для машины. Он пишется для других разработчиков.],
)

